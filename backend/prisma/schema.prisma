generator client {
  	provider = "prisma-client-js"
	binaryTargets = ["native", "darwin-arm64", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  	provider = "postgresql"
  	url      = env("DATABASE_URL")
}


model User{
	id		String		@id @default(uuid())
	email		String		@unique
	username	String		@unique
	passwordHash	String		
	createdAt	DateTime	@default(now())
	updatedAt	DateTime	@updatedAt

	ownedLobbies	Lobby[]		@relation("LobbyOwner")
	memberships	LobbyMember[]
	tagPreferences	LobbyTagPreference[]
}

model Lobby{
	id		String		@id @default(uuid())
	name		String
	maxPlayers	Int
	ownerId		String
	createdAt	DateTime	@default(now())
	updatedAt	DateTime	@updatedAt

	owner		User		@relation("LobbyOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
	members		LobbyMember[]
	tagPreferences	LobbyTagPreference[]
}



model LobbyMember {
	lobbyId 	String
	userId		String
	joinedAt	DateTime 	@default(now())

	lobby	Lobby	@relation(fields: [lobbyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
	user	User	@relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

	@@id([lobbyId, userId])
	@@unique([userId])
}

model LobbyTagPreference{
	lobbyId		String		
	userId		String		
	tagId		String		
	createdAt	DateTime	@default(now())

	lobby	Lobby	@relation(fields: [lobbyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
 	user  	User	@relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  	tag	Tag	@relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)
	
	@@id([lobbyId, userId, tagId])
	@@index([lobbyId, userId])
	@@index([tagId])
}
model Tag{
	id		String		@id @default(uuid())
	slug		String		@unique
	label		String
	createdAt	DateTime	@default(now())
	updatedAt	DateTime	@updatedAt
	preferences	LobbyTagPreference[]
}
	